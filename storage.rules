rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Website images (banners, gallery, faculty photos) are public to read.
    // Only signed-in users can upload/overwrite/delete.
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}

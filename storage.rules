rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Website images are public to read.
    allow read: if true;

    function canUpload() {
      return request.auth != null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Uploads are only allowed into the folder prefixes the app actually
    // writes to, and are capped at 5 MB images for signed-in users.
    match /banners/{file}      { allow create, update: if canUpload(); allow delete: if request.auth != null; }
    match /ads/{file}          { allow create, update: if canUpload(); allow delete: if request.auth != null; }
    match /hero/{file}         { allow create, update: if canUpload(); allow delete: if request.auth != null; }
    match /features/{file}     { allow create, update: if canUpload(); allow delete: if request.auth != null; }
    match /results/{file}      { allow create, update: if canUpload(); allow delete: if request.auth != null; }
    match /faculty/{file}      { allow create, update: if canUpload(); allow delete: if request.auth != null; }
    match /gallery/{file}      { allow create, update: if canUpload(); allow delete: if request.auth != null; }
    match /testimonials/{file} { allow create, update: if canUpload(); allow delete: if request.auth != null; }
    match /uploads/{file}      { allow create, update: if canUpload(); allow delete: if request.auth != null; }
    match /lms/{allPaths=**}      { allow create, update: if canUpload(); allow delete: if request.auth != null; }

    // Any other location is read-only.
  }
}